{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "api/prompts.py", "use": "@vercel/python" },
    { "src": "api/run.py", "use": "@vercel/python" },
    { "src": "api/agent.py", "use": "@vercel/python" },
    { "src": "api/outputs.py", "use": "@vercel/python" },
    { "src": "api/specification.py", "use": "@vercel/python" },
    { "src": "api/projects.py", "use": "@vercel/python" },
    { "src": "web/index.html", "use": "@vercel/static" },
    { "src": "web/styles.css", "use": "@vercel/static" },
    { "src": "web/app.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/prompts", "dest": "/api/prompts.py" },
    { "src": "/api/run", "dest": "/api/run.py" },
    { "src": "/api/agent", "dest": "/api/agent.py" },
    { "src": "/api/outputs", "dest": "/api/outputs.py" },
    { "src": "/api/specification", "dest": "/api/specification.py" },
    { "src": "/api/projects", "dest": "/api/projects.py" },
    { "src": "/api/projects/(.*)", "dest": "/api/projects.py" },
    { "src": "/styles.css", "dest": "/web/styles.css" },
    { "src": "/app.js", "dest": "/web/app.js" },
    { "src": "/", "dest": "/web/index.html" }
  ]
}
